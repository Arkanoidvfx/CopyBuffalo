<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.2.7</Version>
    <Product>CopyBuffalo</Product>
    <AssemblyTitle>CopyBuffalo</AssemblyTitle>
    <Description>CopyBuffalo clipboard history for Windows</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\App.ico</ApplicationIcon>
    <!-- WFO0003: DPI задаёт манифест, это WPF-приложение (WinForms только ради NotifyIcon) -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <!-- Рабочая сборка: dotnet publish -c Release. ReadyToRun — код скомпилирован заранее, панель не ждёт JIT при первом Win+V -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <RuntimeFrameworkVersion>10.0.12</RuntimeFrameworkVersion>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishDir>publish\</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms нужен только ради NotifyIcon; его implicit usings конфликтуют с WPF -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\App.ico" />
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <EmbeddedResource Include="Assets\Vfx\Nether\*.png" />
    <Resource Include="Assets\Fonts\*.ttf;Assets\Fonts\*.ttc;Assets\Fonts\*-OFL.txt" />
    <Content Include="Assets\Fonts\IBM-Plex-OFL.txt" Link="licenses\IBM-Plex-OFL.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="Assets\Fonts\Noto-OFL.txt" Link="licenses\Noto-OFL.txt"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Ocr\**\*" Link="ocr\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="VerifyOcrBundle" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('Assets\Ocr\copybuffalo-ocr.exe') Or !Exists('Assets\Ocr\det\inference.onnx') Or !Exists('Assets\Ocr\det\inference.yml') Or !Exists('Assets\Ocr\rec\inference.onnx') Or !Exists('Assets\Ocr\rec\inference.yml') Or !Exists('Assets\Ocr\licenses\NOTICE.txt')"
           Text="Build the local OCR bundle first: pwsh -File tools/ocr/Build-Ocr.ps1" />
  </Target>

</Project>
