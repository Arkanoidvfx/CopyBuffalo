<Window x:Class="ArkCopyBuffer.TextMergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Объединить тексты — ArkCopyBuffer" Width="1180" Height="680" MinWidth="780" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource TextFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="MergeRow" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Card" Padding="12" CornerRadius="7" BorderThickness="1"
                                    Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="Before" Height="2" VerticalAlignment="Top" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                            <Border x:Name="After" Height="2" VerticalAlignment="Bottom" Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
                            <Trigger Property="Tag" Value="Before"><Setter TargetName="Before" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="Tag" Value="After"><Setter TargetName="After" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="Sheet" Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Объединить тексты" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Перетащите карточки для порядка, пути — в нужные слоты."
                           Margin="0,6,12,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UndoButton" Content="&#xE7A7;" Style="{StaticResource SubtleIconButton}" Width="32"
                        ToolTip="Отменить (Ctrl+Z)" AutomationProperties.Name="Отменить объединение" Click="Undo_Click"/>
                <Button x:Name="RedoButton" Content="&#xE7A6;" Style="{StaticResource SubtleIconButton}" Width="32"
                        ToolTip="Повторить (Ctrl+Y)" AutomationProperties.Name="Повторить объединение" Click="Redo_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
            <Grid Margin="0,0,16,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Порядок текстов" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Тяните карточки за текст или ручку." Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <ListBox x:Name="Sources" Grid.Row="1" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource MergeRow}" AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseLeftButtonDown="Source_MouseDown" PreviewMouseMove="Source_MouseMove"
                         DragOver="Order_DragOver" DragLeave="Order_DragLeave" Drop="Order_Drop"
                         AutomationProperties.Name="Порядок выбранных текстов">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,1,10,0">
                                    <TextBlock Text="&#xE784;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding Number}" Margin="0,7,0,0" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MaxHeight="60"
                                               LineStackingStrategy="BlockLineHeight" LineHeight="20">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMono}" Value="True">
                                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource SubtleIconButton}" Width="24" Height="24"
                                        VerticalAlignment="Top" Margin="6,-4,-6,0" ToolTip="Убрать из объединения"
                                        AutomationProperties.Name="Убрать из объединения" Click="Remove_Click"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="&#xE70E;" FontFamily="{StaticResource IconFont}" Style="{StaticResource StandardButton}" Width="36" ToolTip="Выше (Alt+↑)" AutomationProperties.Name="Поднять текст" Click="Up_Click"/>
                    <Button Content="&#xE70D;" FontFamily="{StaticResource IconFont}" Style="{StaticResource StandardButton}" Width="36" Margin="8,0,0,0" ToolTip="Ниже (Alt+↓)" AutomationProperties.Name="Опустить текст" Click="Down_Click"/>
                </StackPanel>
            </Grid>
            <Border Grid.Column="1" BorderThickness="1,0,1,0" BorderBrush="{DynamicResource CardStroke}" Padding="16,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Пути в команде" FontSize="17" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <ToggleButton x:Name="UseSlots" Style="{StaticResource ToggleSwitch}" IsChecked="True"
                                          Checked="Mode_Changed" Unchecked="Mode_Changed" AutomationProperties.Name="Подставлять пути в слоты"/>
                            <TextBlock Text="Подставлять в слоты" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="SlotsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      IsEnabled="{Binding IsChecked, ElementName=UseSlots}">
                            <ItemsControl x:Name="SlotList" AutomationProperties.Name="Слоты для путей">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12" Margin="0,0,0,10" CornerRadius="7" BorderThickness="1"
                                                Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}"
                                                AllowDrop="True" PreviewDragOver="Slot_DragOver" PreviewDragLeave="Slot_DragLeave" PreviewDrop="Slot_Drop"
                                                PreviewMouseLeftButtonDown="Source_MouseDown" PreviewMouseMove="Source_MouseMove">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Heading}" ToolTip="{Binding Owner.Title}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                                <Grid Margin="0,5,0,5">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                                    <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource SubtleIconButton}" Width="24" Height="24"
                                                            Margin="5,0,-4,0" IsEnabled="{Binding Assigned}" Click="Clear_Click" ToolTip="Освободить слот" AutomationProperties.Name="Освободить слот"/>
                                                </Grid>
                                                <Button Content="{Binding Value}" Tag="PathValue" Style="{StaticResource StandardButton}" Height="Auto" MinHeight="40"
                                                        Padding="10,8" HorizontalContentAlignment="Left" Click="Assign_Click" AutomationProperties.Name="{Binding Label}">
                                                    <Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" MaxHeight="60"/></DataTemplate></Button.ContentTemplate>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock x:Name="NoSlots" Text="Пустых кавычек и заглушек нет. Тексты объединятся построчно."
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="8"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <Button x:Name="AssignOrderButton" Content="Пути в слоты по порядку" Style="{StaticResource StandardButton}" Click="AssignOrder_Click"/>
                        <TextBlock Text="Или выберите путь слева и нажмите слот. Перенос между занятыми слотами меняет назначения местами."
                                   FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="2" Margin="18,0,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Результат" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ResultCount" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource ControlStroke}" Background="{DynamicResource DialogSurface}">
                    <TextBox x:Name="Result" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="16"
                             Foreground="{DynamicResource TextPrimary}" SelectionBrush="{DynamicResource Accent}"
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Предпросмотр объединённого текста">
                        <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></ControlTemplate></TextBox.Template>
                    </TextBox>
                </Border>
            </Grid>
        </Grid>
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Status" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                       Foreground="{DynamicResource TextSecondary}" AutomationProperties.LiveSetting="Polite"
                       Text="Исходные записи останутся в истории · Ctrl+Enter — объединить · Esc — закрыть"/>
            <Button x:Name="MergeButton" Grid.Column="1" Content="Объединить и скопировать" Style="{StaticResource AccentButton}" Padding="18,0" Click="Merge_Click"/>
        </Grid>
        <Popup x:Name="Ghost" AllowsTransparency="True" Placement="Relative" StaysOpen="True" IsHitTestVisible="False" Focusable="False" PopupAnimation="None">
            <Border x:Name="GhostCard" Width="230" Padding="12" Margin="16" CornerRadius="8" BorderThickness="1" CacheMode="BitmapCache"
                    Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.3"/></Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="GhostText" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" MaxHeight="60" FontSize="13"/>
                    <TextBlock x:Name="GhostHint" Text="Выберите порядок или слот" FontSize="11" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
