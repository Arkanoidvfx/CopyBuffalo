<Window x:Class="ArkCopyBuffer.TextEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать текст — ArkCopyBuffer" Width="1060" Height="640" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WindowSurface}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource TextFont}" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="EditorButton" TargetType="Button" BasedOn="{StaticResource SubtleIconButton}">
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </Window.Resources>
    <Grid x:Name="Sheet" Background="{DynamicResource WindowSurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="280"/></Grid.ColumnDefinitions>
        <Grid Margin="28,24,28,20">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Редактировать текст" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="Origin" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondary}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Button x:Name="UndoButton" Content="&#xE7A7;" Style="{StaticResource EditorButton}"
                        ToolTip="Отменить правку (Ctrl+Z)" AutomationProperties.Name="Отменить правку" Click="Undo_Click"/>
                <Button x:Name="RedoButton" Content="&#xE7A6;" Style="{StaticResource EditorButton}"
                        ToolTip="Повторить правку (Ctrl+Y)" AutomationProperties.Name="Повторить правку" Click="Redo_Click"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Margin="28,0,28,20" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource ControlStroke}">
            <Grid>
                <TextBox x:Name="Editor" Background="Transparent" BorderThickness="0" Padding="20,16"
                         Foreground="{DynamicResource TextPrimary}" CaretBrush="{DynamicResource TextPrimary}"
                         SelectionBrush="{DynamicResource Accent}" FontSize="16"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         IsUndoEnabled="True" UndoLimit="100" AutomationProperties.Name="Текст записи"
                         TextChanged="Editor_TextChanged" SelectionChanged="Editor_SelectionChanged">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
                <Border Height="2" VerticalAlignment="Bottom" Margin="8,0" Background="{DynamicResource Accent}" IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Opacity" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=Editor}" Value="True">
                                    <Setter Property="Opacity" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="{DynamicResource DialogSurface}" BorderBrush="{DynamicResource CardStroke}"
                BorderThickness="0,1,0,0" Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusGlyph" FontFamily="{StaticResource IconFont}" Margin="0,1,8,0"/>
                        <TextBlock x:Name="Status" Text="Сохранено" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                    <TextBlock Text="Автосохранение после 1 секунды паузы и при закрытии" FontSize="12"
                               Margin="22,5,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="Count" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
            </Grid>
        </Border>
        <Border Grid.Column="1" Grid.RowSpan="3" BorderThickness="1,0,0,0"
                BorderBrush="{DynamicResource CardStroke}" Background="{DynamicResource DialogSurface}">
            <Grid Margin="16,24,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Взять из истории" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Выделите фрагмент слева, чтобы заменить его текстом другой записи."
                               Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
                <TextBox x:Name="HistorySearch" Grid.Row="1" Style="{StaticResource SearchBox}" Margin="0,0,0,12"
                         Tag="Поиск в истории" AutomationProperties.Name="Поиск текста в истории" TextChanged="HistorySearch_TextChanged"/>
                <Grid Grid.Row="2">
                    <ListBox x:Name="Sources" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Sources_SelectionChanged"
                             MouseDoubleClick="Sources_DoubleClick" AutomationProperties.Name="Другие текстовые записи">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Padding" Value="12"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Card" Padding="{TemplateBinding Padding}" CornerRadius="6"
                                                    Background="{DynamicResource CardFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHover}"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                                               LineStackingStrategy="BlockLineHeight" LineHeight="20">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMono}" Value="True">
                                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="{Binding SourceApp}" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                        <TextBlock Text="{Binding TimeLabel}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondary}" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="Других текстовых записей нет" TextWrapping="Wrap" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=Sources}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <Button x:Name="InsertButton" Content="Вставить в текст" Style="{StaticResource AccentButton}" Click="Insert_Click"/>
                    <Button x:Name="ReplacePathButton" Content="Заменить путь в команде" Style="{StaticResource StandardButton}"
                            Margin="0,8,0,0" Click="ReplacePath_Click"/>
                    <TextBlock x:Name="PathHint" Text="Выберите запись из истории" Margin="0,8,0,0" FontSize="11"
                               Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
